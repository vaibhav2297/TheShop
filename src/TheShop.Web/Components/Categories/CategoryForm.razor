@using TheShop.Web.Common
@using TheShop.Web.Common.UI
@using TheShop.Web.Components.Common

<EditForm Model="@Model" OnSubmit="OnSave" novalidate>
    <ShopCommandValidation @ref="_validation" />
    <div class="shop-categories-form">
        <div><ShopImageUpload @ref="_imageUpload" Files="Images"
                             FilesChanged="ImagesChanged"
                             UploadText="@Strings.AddCategory_ImageUploadButton"
                             RemoveLabel="@Strings.AddCategory_ImageRemove"
                             PreviewAlt="@Strings.AddCategory_ImageLabel"
                             InvalidTypeError="@Strings.Category_ImageInvalidType"
                             MaxFileSizeError="@Strings.Category_ImageTooLarge"
                             Multiple="false"
                             Disabled="@Busy" /></div>
        <div class="shop-categories-fields">
            <ShopTextField @bind-Value="Model.Name" Label="@Strings.AddCategory_NameLabel" required
                           Disabled="@Busy" data-testid="@NameTestId" />
            <ShopTextField @bind-Value="Model.Description" Label="@Strings.AddCategory_DescriptionLabel" Disabled="@Busy" />
            <fieldset class="shop-categories-status" disabled="@Busy">
                <legend>@Strings.AddCategory_StatusLabel</legend>
                <div>
                    <ShopChip Selected="@Model.IsActive" SelectedChanged="@((bool _) => Model.IsActive = true)" Disabled="@Busy">@Strings.AddCategory_StatusActive</ShopChip>
                    <ShopChip Selected="@(!Model.IsActive)" SelectedChanged="@((bool _) => Model.IsActive = false)" Disabled="@Busy">@Strings.AddCategory_StatusInactive</ShopChip>
                </div>
            </fieldset>
            <div class="shop-categories-form-actions">
                <ShopButton Type="submit" Size="ShopSize.Large" Loading="@Busy" EndIcon="@ShopIcons.Outlined.Arrow_Right_MD" data-testid="@SaveTestId">@Strings.Save</ShopButton>
                <ShopButton Variant="ShopVariant.Outlined" Size="ShopSize.Large" Disabled="@Busy" Href="@Routes.Admin.ManageCategories">@Strings.Cancel</ShopButton>
            </div>
        </div>
    </div>
</EditForm>
