@using TheShop.Web.Common.UI
@inherits ShopComponentBase

<fieldset @attributes="AdditionalAttributes" class="@ClassName" style="@Style" disabled="@IsDisabled"
          aria-label="@Label" id="@_id">
    <legend class="shop-visually-hidden">@Label</legend>
    <div class="shop-range-stage" style="@TrackStyle">
        <div class="shop-range-rail" aria-hidden="true"><div class="shop-range-fill"></div></div>
        <input class="shop-range-thumb shop-range-lower" type="range" min="@Number(Min)" max="@Number(Max)" step="any" data-step="@Number(Step)"
               disabled="@IsDisabled" aria-label="@MinimumLabel" aria-valuemin="@Number(Min)"
               aria-valuemax="@Number(_current.Upper)" aria-valuetext="@Format(_current.Lower)"
               @bind:get="_current.Lower" @bind:set="SetLowerAsync" @bind:event="oninput"
               @onfocus="@(() => _activeThumb = 0)" @onblur="@(() => _activeThumb = null)" />
        <input class="shop-range-thumb shop-range-upper" type="range" min="@Number(Min)" max="@Number(Max)" step="any" data-step="@Number(Step)"
               disabled="@IsDisabled" aria-label="@MaximumLabel" aria-valuemin="@Number(_current.Lower)"
               aria-valuemax="@Number(Max)" aria-valuetext="@Format(_current.Upper)"
               @bind:get="_current.Upper" @bind:set="SetUpperAsync" @bind:event="oninput"
               @onfocus="@(() => _activeThumb = 1)" @onblur="@(() => _activeThumb = null)" />
        @if (_activeThumb is { } active && !IsDisabled)
        {
            <div class="@BubbleClass" popover="manual" aria-hidden="true"><span>@Format(active == 0 ? _current.Lower : _current.Upper)</span></div>
        }
    </div>
    <div class="shop-range-bounds" aria-hidden="true"><span>@Format(Min)</span><span>@Format(Max)</span></div>
    <div class="shop-range-inputs" @key="_bounds">
        <ShopNumericField Label="@MinimumLabel" Value="@_current.Lower"
                          ValueChanged="@(value => SetLowerAsync(value!.Value))" ValueExpression="@(() => _lowerValue)"
                          Min="@Min" Max="@_current.Upper" ValueFormatter="@ValueFormatter" Required="true"
                          RequiredError="@ErrorText(true)" ParsingError="@ErrorText(true)" Disabled="@IsDisabled" />
        <ShopNumericField Label="@MaximumLabel" Value="@_current.Upper"
                          ValueChanged="@(value => SetUpperAsync(value!.Value))" ValueExpression="@(() => _upperValue)"
                          Min="@_current.Lower" Max="@Max" ValueFormatter="@ValueFormatter" Required="true"
                          RequiredError="@ErrorText(false)" ParsingError="@ErrorText(false)" Disabled="@IsDisabled" />
    </div>
</fieldset>
