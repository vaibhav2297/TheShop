@using TheShop.Web.Common.UI
@using TheShop.Web.Resources
@inherits ShopComponentBase

<div @attributes="AdditionalAttributes"
     id="@_containerId"
     class="@ClassName"
     style="@Style">

    <div class="shop-otp-input-digits">
        @for (var i = 0; i < Length; i++)
        {
            var slot = _digits[i];
            var idx = i;
            <ShopTextField Value="@slot.Value"
                           ValueChanged="@(v => OnDigitChangedAsync(idx, v))"
                           ValueExpression="@(() => slot.Value)"
                           Disabled="@Disabled"
                           type="text"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           aria-label="@string.Format(Strings.OtpInput_DigitAriaLabel, idx + 1, Length)"
                           aria-describedby="@HelperId"
                           class="shop-otp-digit"
                           @onkeydown="@(e => OnKeyDownAsync(idx, e))" />
        }
    </div>

    @if (!string.IsNullOrEmpty(HelperText))
    {
        <p id="@HelperId" class="shop-otp-input-hint">@HelperText</p>
    }

</div>
