@* Components/Common/ShopConfirmDialog.razor *@

<ShopDialog Title="@TitleText">
    <ChildContent>
        <MudText Typo="Typo.body1">@BodyText</MudText>
    </ChildContent>
    <Actions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@CancelLabel</MudButton>
        <MudButton Variant="Variant.Filled" Color="@ConfirmColor" OnClick="Confirm">@ConfirmLabel</MudButton>
    </Actions>
</ShopDialog>
