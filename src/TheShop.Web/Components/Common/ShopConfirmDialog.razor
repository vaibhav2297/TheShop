@using TheShop.Web.Common.UI

<ShopDialog DescriptionId="@_bodyId" OnDismiss="CancelAsync">
    <TitleContent>
        <h2 class="shop-dialog-title">@Options.Title</h2>
    </TitleContent>
    <DialogContent>
        <p id="@_bodyId" class="shop-dialog-description">@Options.Body</p>
    </DialogContent>
    <DialogActions>
        <ShopButton Variant="ShopVariant.Text" OnClick="CancelAsync"
                    data-dialog-initial-focus="true" data-testid="dialog-cancel">@Options.CancelLabel</ShopButton>
        <ShopButton Color="@ConfirmColor" OnClick="ConfirmAsync"
                    data-testid="dialog-confirm">@Options.ConfirmLabel</ShopButton>
    </DialogActions>
</ShopDialog>
