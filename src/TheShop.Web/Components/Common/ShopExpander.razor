@using TheShop.Web.Common.UI
@inherits ShopComponentBase

<div @attributes="AdditionalAttributes" class="@ClassName" style="@Style">
    <div class="shop-expander-header">
        <div id="@_titleId" class="shop-expander-title">
            @if (TitleContent is not null)
            {
                @TitleContent
            }
            else
            {
                <h3 class="shop-expander-default-title">@Title</h3>
            }
        </div>
        @if (OverviewContent is not null)
        {
            <div id="@_overviewId" class="shop-expander-overview">@OverviewContent</div>
        }
        <ShopIcon Icon="@ToggleIcon" Class="shop-expander-icon" />
        <button id="@_headerId" type="button" class="shop-expander-trigger"
                disabled="@Disabled" aria-expanded="@_expanded.ToString().ToLowerInvariant()"
                aria-controls="@_contentId" aria-labelledby="@_titleId"
                aria-describedby="@(OverviewContent is not null ? _overviewId : null)" @onclick="ToggleAsync">
        </button>
    </div>
    <div id="@_contentId" class="shop-expander-content" inert="@(!_expanded)"
         aria-hidden="@(!_expanded ? "true" : null)" aria-labelledby="@_headerId">
        <div class="shop-expander-content-inner">
            <div class="shop-expander-body">@ChildContent</div>
        </div>
    </div>
</div>
