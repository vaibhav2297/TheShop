@using TheShop.Web.Common.UI
@inherits ShopComponentBase

@if (Href is not null)
{
    <a @attributes="AdditionalAttributes" @ref="_element"
       href="@(IsDisabled ? null : Href)"
       role="link"
       tabindex="@LinkTabIndex"
       aria-disabled="@IsDisabled.ToString().ToLowerInvariant()"
       aria-busy="@Loading.ToString().ToLowerInvariant()"
       class="@ClassName"
       style="@Style"
       @onclick="OnClickAsync"
       @onclick:preventDefault="IsDisabled">
        @ButtonContent
    </a>
}
else
{
    <button @attributes="AdditionalAttributes" @ref="_element"
        type="@ButtonType"
        class="@ClassName"
        style="@Style"
        disabled="@IsDisabled"
        aria-busy="@Loading.ToString().ToLowerInvariant()"
        @onclick="OnClickAsync">
        @ButtonContent
    </button>
}
<span class="shop-visually-hidden" role="status">@(Loading ? Strings.Loading : null)</span>

@code {
    private RenderFragment ButtonContent => @<text><span class="shop-button-content">
        @if (!string.IsNullOrEmpty(StartIcon))
        {
            <ShopIcon Icon="@StartIcon" Class="shop-button-icon" />
        }
        @ChildContent
        @if (!string.IsNullOrEmpty(EndIcon))
        {
            <ShopIcon Icon="@EndIcon" Class="shop-button-icon" />
        }
    </span>
    @if (Loading)
    {
        <ShopLoader Class="shop-button-spinner" />
    }</text>;
}
