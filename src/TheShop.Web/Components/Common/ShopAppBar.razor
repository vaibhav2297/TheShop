@using TheShop.Web.Common
@using TheShop.Web.Common.UI
@inherits ShopComponentBase

<header @attributes="AdditionalAttributes" class="@ClassName" style="@Style">
    <a class="shop-appbar-logo" href="@Routes.Home">
        <ShopImage Src="@ShopIcons.ImageAssets.LogoIcon" Preset="ShopImagePreset.BrandLogo"
                   Alt="@Strings.AppName" PlaceholderLabel="@Strings.AppName" />
    </a>
    <nav class="shop-appbar-navigation" aria-label="@Strings.Nav_Primary">
        <a class="shop-button shop-button-text shop-button-primary shop-button-small" href="@Routes.Home">@Strings.Nav_Home</a>
        <a class="shop-button shop-button-text shop-button-primary shop-button-small" href="@Routes.Products">@Strings.Nav_Products</a>
        <a class="shop-button shop-button-text shop-button-primary shop-button-small" href="@Routes.Categories">@Strings.Nav_Categories</a>
        <a class="shop-button shop-button-text shop-button-primary shop-button-small" href="@Routes.Brands">@Strings.Nav_Brands</a>
        <a class="shop-button shop-button-text shop-button-primary shop-button-small" href="@Routes.Deals">@Strings.Nav_Deals</a>
    </nav>
    <div class="shop-appbar-actions">
        <ShopIconButton Icon="@ShopIcons.Outlined.Search_Magnifying_Glass"
                        Variant="ShopVariant.Outlined" Label="@Strings.Nav_Search" />
        <a class="shop-button shop-icon-button shop-button-outlined shop-button-primary shop-button-medium"
           href="@Routes.Cart" aria-label="@Strings.Nav_Cart">
            <ShopIcon Icon="@ShopIcons.Outlined.Shopping_Bag_01" />
        </a>
        <AuthorizeView>
            <Authorized>
                <ProfileMenu />
            </Authorized>
            <NotAuthorized>
                <a class="shop-button shop-icon-button shop-button-outlined shop-button-primary shop-button-medium"
                   href="@Routes.Auth.SignIn" aria-label="@Strings.Nav_Account">
                    <ShopIcon Icon="@ShopIcons.Outlined.User_02" />
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</header>
