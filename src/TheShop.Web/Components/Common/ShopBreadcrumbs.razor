@inherits MudComponentBase
@using TheShop.Web.Resources
@using TheShop.Web.Theme

<nav aria-label="@Strings.Breadcrumb_AriaLabel">
    <MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged">

        <MudBreadcrumbs Items="@Items"
                        MaxItems="@_maxItems"
                        ExpanderIcon="@ShopIcons.Outlined.More_Horizontal"
                        Class="@Classname"
                        Style="@Stylename">

            <SeparatorTemplate>
                <MudIcon Icon="@ShopIcons.Outlined.Chevron_Right_MD"
                         Size="Size.Small" />
            </SeparatorTemplate>

            <ItemTemplate Context="item">
                <MudButton Href="@(item.Disabled ? null : item.Href)"
                           Size="Size.Small"
                           Variant="Variant.Text"
                           Color="Color.Primary"
                           Class="shop-breadcrumb-item"
                           title="@item.Text"
                           aria-current="@(item.Disabled ? "page" : null)">@item.Text</MudButton>
            </ItemTemplate>

        </MudBreadcrumbs>

    </MudBreakpointProvider>
</nav>
