@using TheShop.Web.Common.UI
@using TheShop.Web.Components.Common
@inherits ShopComponentBase

<article @attributes="AdditionalAttributes" class="@ClassName" style="@Style">
    <div class="shop-admin-module-card-content">
        <h2 class="shop-admin-module-card-label">@Label</h2>
        <p class="shop-admin-module-card-count">@CountText</p>
    </div>

    <ShopButton Href="@Href" Variant="ShopVariant.Outlined" Color="ShopColor.Primary"
                EndIcon="@ShopIcons.Outlined.Edit_Pencil_02" Class="shop-admin-module-card-action"
                aria-label="@AriaLabel">
        @ManageLabel
    </ShopButton>
</article>
