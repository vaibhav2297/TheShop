@inherits LayoutComponentBase

@using TheShop.Web.Components.Common
@using TheShop.Web.Theme

<MudThemeProvider Theme="@ShopTheme.BuildTheme()"
                  IsDarkMode="false" />
<MudPopoverProvider />

<ShopUiHost />

<MudLayout Class="d-flex flex-column overflow-hidden">

    @if (Announcement.HasAnnouncement)
    {
        <ShopAnnouncementBar Message="@Announcement.Message" />
    }

    <ShopAppBar OnAccountClick="OpenProfileDrawer" AccountOpen="@_profileDrawerOpen" />

    @if (Breadcrumbs.HasTrail)
    {
        <ShopBreadcrumbs Items="@Breadcrumbs.Trail" />
    }

    <MudMainContent Class="shop-main-scroll flex-grow-1 overflow-y-auto overflow-x-hidden min-height-0 pt-0" data-shop-scroll-root>

        <MudStack Spacing="0" AlignItems="AlignItems.Stretch" Class="min-height-full">

            @Body

            @if (Footer.Visible)
            {
                <ShopFooter Class="mt-auto" />
            }

        </MudStack> 
    </MudMainContent>

</MudLayout>

<AuthorizeView>
    <Authorized>
        <ProfileDrawer @bind-Open="_profileDrawerOpen" />
    </Authorized>
</AuthorizeView>
