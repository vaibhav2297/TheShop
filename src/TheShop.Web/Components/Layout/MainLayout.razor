@inherits LayoutComponentBase

@using TheShop.Web.Components.Common
@using TheShop.Web.Common.UI
@using TheShop.Web.Theme

<MudThemeProvider Theme="@ShopTheme.BuildTheme()"
                  IsDarkMode="false" />
<MudPopoverProvider />

<ShopUiHost />

<MudLayout Class="shop-shell d-flex flex-column overflow-hidden">

    @if (Announcement.HasAnnouncement)
    {
        <ShopAnnouncementBar Message="@Announcement.Message" />
    }

    <ShopAppBar OnAccountClick="OpenProfileDrawer" AccountOpen="@ProfileOpen"
                OnMenuClick="OpenNavigationDrawer" MenuOpen="@NavigationOpen"
                MenuDrawerId="@_navigationDrawerId" OnMenuUnavailable="CloseNavigationDrawer" />

    @if (Breadcrumbs.HasTrail)
    {
        <ShopBreadcrumbs Items="@Breadcrumbs.Trail" />
    }

    <MudMainContent Class="shop-main-scroll flex-grow-1 overflow-y-auto overflow-x-hidden min-height-0 pt-0" data-shop-scroll-root>

        <div class="shop-shell-page">

            @Body

            @if (Footer.Visible)
            {
                <ShopFooter />
            }

        </div>
    </MudMainContent>

</MudLayout>

<ShopDrawer id="@_navigationDrawerId" Side="ShopDrawerSide.Left" Class="shop-navigation-drawer"
            Open="@NavigationOpen" OpenChanged="NavigationOpenChanged">
    <HeaderContent><h2 class="shop-drawer-title">@Strings.Nav_Menu</h2></HeaderContent>
    <DrawerContent><ShopPrimaryNavigation OnNavigate="CloseNavigationDrawer" /></DrawerContent>
</ShopDrawer>

<AuthorizeView>
    <Authorized>
        <ProfileDrawer Open="@ProfileOpen" OpenChanged="ProfileOpenChanged" />
    </Authorized>
</AuthorizeView>
