@* Components/Products/ProductFilterPanel.razor *@
@inherits MudComponentBase

@using TheShop.Web.Common
@using TheShop.Web.Resources
@using TheShop.Domain.Enums

<MudStack Class="@Class"
          Style="@Style"
          Spacing="6"
          AlignItems="AlignItems.Stretch">

    @if (Groups is { Count: > 0 })
    {
        <MudExpansionPanels MultiExpansion
                            Elevation="0"
                            Square
                            Outlined>

            @foreach (var group in Groups)
            {
                @if (group.Kind == FilterKind.MultiSelect)
                {
                    var selectedCount = CountSelected(group.Key);

                    <MudExpansionPanel Icon="@ShopIcons.Outlined.Caret_Down_MD"
                                       Class="mud-transparent">

                        <TitleContent>

                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      Justify="Justify.SpaceBetween"
                                      Spacing="2">

                                <MudText Typo="Typo.subtitle1">@Localizer[group.LabelKey]</MudText>

                                @if (selectedCount > 0)
                                {
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Variant="Variant.Outlined">

                                        <MudText Typo="Typo.caption"
                                                 Color="Color.Primary">@selectedCount</MudText>

                                    </MudChip>
                                }

                            </MudStack>

                        </TitleContent>

                        <ChildContent>

                            <MudStack Spacing="0">

                                @foreach (var option in group.Options)
                                {
                                    var isChecked = IsSelected(group.Key, option.Value);

                                    <MudCheckBox T="bool"
                                                 Value="@isChecked"
                                                 Color="Color.Primary"
                                                 UncheckedColor="Color.Secondary"
                                                 ValueChanged="@(isChecked => OnOptionToggledAsync(group.Key, option.Value, isChecked))">

                                        <MudText Typo="@(isChecked ? Typo.subtitle2 : Typo.body2)">@option.Label</MudText>

                                    </MudCheckBox>
                                }

                            </MudStack>
                        </ChildContent>

                    </MudExpansionPanel>
                }
                else
                {
                    <MudExpansionPanel Icon="@ShopIcons.Outlined.Caret_Down_MD"
                                       Class="mud-transparent">

                        <TitleContent>

                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      Justify="Justify.SpaceBetween"
                                      Spacing="2">

                                <MudText Typo="Typo.subtitle1">@Localizer[group.LabelKey]</MudText>

                                @if (group.Range is not null)
                                {
                                    <MudText Typo="Typo.caption"
                                             Color="Color.Secondary">@RangeHeaderText</MudText>
                                }

                            </MudStack>

                        </TitleContent>

                        <ChildContent>

                            @if (group.Range is { } range)
                            {

                                <MudRangeSlider T="decimal"
                                                Immediate
                                                ValueLabel
                                                Class="py-2"
                                                Min="@range.Min"
                                                Max="@range.Max"
                                                Variant="Variant.Filled"
                                                Color="Color.Primary"
                                                Value="_sliderMin"
                                                ValueChanged="OnSliderMinChangedAsync"
                                                UpperValue="_sliderMax"
                                                UpperValueChanged="OnSliderMaxChangedAsync"
                                                LabelText="@CurrencyFormatter.Format(_sliderMin)"
                                                UpperLabelText="@CurrencyFormatter.Format(_sliderMax)" />

                            }

                        </ChildContent>

                    </MudExpansionPanel>
                }
            }

        </MudExpansionPanels>

        @if (HasActiveFilters)
        {
            <MudStack Row
                      AlignItems="AlignItems.Center"
                      Justify="Justify.FlexEnd">

                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="OnClearFiltersAsync">
                    @Strings.Filter_Clear
                </MudButton>

            </MudStack>
        }
    }
    else
    {
        <MudText Typo="Typo.body1"
                 Color="Color.Secondary">@Strings.No_Filters</MudText>
    }

</MudStack>
