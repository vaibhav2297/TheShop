@inherits ShopComponentBase
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@using TheShop.Web.Common.UI
@using TheShop.Domain.ValueObjects

<NavigationLock ConfirmExternalNavigation="@_dirty" OnBeforeInternalNavigation="OnBeforeInternalNavigationAsync" />

<EditForm Model="@_model" OnSubmit="SaveAsync" @attributes="AdditionalAttributes" class="@Classname" style="@Style" novalidate>
    <ShopCommandValidation @ref="_validation" FieldMap="@CommandFieldMap" />
    <BusyFor Key="@BusyKeys.Products.SaveProduct" Context="busy">
        <ShopExpander Expanded="true" Disabled="@busy">
            <TitleContent>
                <h2 class="shop-product-section-title">@Strings.ProductForm_GeneralInfoHeading</h2>
            </TitleContent>
            <ChildContent>
                <div class="shop-product-general">
                    <div class="shop-product-gallery">
                        <ShopImageUpload @ref="_imageUpload" Files="@_galleryImages" FilesChanged="OnGalleryImagesChanged"
                                         Multiple="true" MaxFileCount="int.MaxValue" ShowPrimaryBadge="true" Disabled="@busy"
                                         UploadText="@Strings.ImageUpload_Add" RemoveLabel="@Strings.AddProduct_ImageRemove"
                                         PreviewAlt="@Strings.ImageUpload_ProductImages" InvalidTypeError="@Strings.Product_ImageInvalidType"
                                         MaxFileSizeError="@Strings.Product_ImageTooLarge" PrimaryLabel="@Strings.AddProduct_ImagePrimary" />
                        <p class="shop-product-hint"><ShopIcon Icon="@ShopIcons.Outlined.Info" />@Strings.ProductForm_GalleryVariantsHint</p>
                    </div>
                    <div class="shop-product-fields">
                        <ShopTextField Value="@_model.Name" ValueChanged="OnNameChanged" ValueExpression="@(() => _model.Name)"
                                       Label="@Strings.AddProduct_NameLabel" Disabled="@busy" required data-testid="product-name" />
                        <div class="shop-product-description" role="group" aria-labelledby="@_descriptionLabelId" aria-describedby="@DescriptionErrorId">
                            <label id="@_descriptionLabelId">@Strings.AddProduct_DescriptionLabel</label>
                            <ShopRichTextEditor Value="@_model.Description" ValueChanged="OnDescriptionChanged"
                                                TextLengthChanged="@(length => _textLength = length)"
                                                OnUnsupportedPaste="@(() => _showPasteNotice = true)"
                                                AriaLabelledBy="@_descriptionLabelId" Disabled="@busy" />
                            @if (_showPasteNotice)
                            {
                                <p class="shop-product-hint" role="status">@Strings.AddProduct_DescriptionFormattingRemoved</p>
                            }
                            <p class="shop-product-counter">@string.Format(Strings.AddProduct_DescriptionCounter, _textLength, ProductDescription.MaxTextLength)</p>
                            <div id="@DescriptionErrorId" class="shop-product-error" aria-live="polite"><ValidationMessage For="@(() => _model.Description)" /></div>
                        </div>
                        @if (HasVariants)
                        {
                            <p class="shop-product-hint"><ShopIcon Icon="@ShopIcons.Outlined.Info" />
                                @(LowestVariantPrice is { } min ? string.Format(Strings.AddProduct_PriceRangeNoteWithValue, CurrencyFormatter.Format(min)) : Strings.ProductForm_VariantPricingHint)
                            </p>
                        }
                        else
                        {
                            <div class="shop-product-field-pair">
                                <ShopMoneyField @ref="_originalPriceField" Value="@_model.OriginalPrice" ValueExpression="@(() => _model.OriginalPrice)"
                                                ValueChanged="OnOriginalPriceChanged" Label="@Strings.AddProduct_PriceLabel" AriaRequired="true" Disabled="@busy" />
                                <ShopMoneyField @ref="_salePriceField" Value="@_model.SalePrice" ValueExpression="@(() => _model.SalePrice)"
                                                ValueChanged="OnSalePriceChanged" Label="@Strings.AddProduct_SalePriceLabel" Disabled="@busy" />
                            </div>
                        }
                        <div class="shop-product-field-pair">
                            <ShopSelect TValue="Guid?" Value="@_model.BrandId" ValueChanged="OnBrandChanged" ValueExpression="@(() => _model.BrandId)"
                                        Options="@BrandOptions" Label="@Strings.AddProduct_BrandLabel" aria-required="true" Disabled="@busy" />
                            <ShopSelect TValue="Guid?" Value="@_model.CategoryId" ValueChanged="OnCategoryChanged" ValueExpression="@(() => _model.CategoryId)"
                                        Options="@CategoryOptions" Label="@Strings.AddProduct_CategoryLabel" aria-required="true" Disabled="@busy" />
                        </div>
                        <fieldset class="shop-product-status">
                            <legend>@Strings.AddProduct_StatusLabel</legend>
                            <div>
                                <ShopChip Selected="@_model.IsPublished" SelectedChanged="@(_ => OnPublishedChangedAsync(true))" Disabled="@busy">@Strings.AddProduct_StatusActive</ShopChip>
                                <ShopChip Selected="@(!_model.IsPublished)" SelectedChanged="@(_ => OnPublishedChangedAsync(false))" Disabled="@busy">@Strings.AddProduct_StatusInactive</ShopChip>
                            </div>
                        </fieldset>
                        <ShopTextField Value="@_model.Sku" ValueExpression="@(() => _model.Sku)" Label="@Strings.AddProduct_SkuLabel"
                                       HelperText="@Strings.AddProduct_SkuHelperText" readonly Disabled="@busy" data-testid="product-sku" />
                    </div>
                </div>
            </ChildContent>
        </ShopExpander>

        <ProductContentCard InitialSpecifications="@(InitialData?.Specifications ?? [])" StateChanged="OnSpecificationsStateChanged"
                            FlaggedRowPositions="@_specificationsFlaggedByServer" Disabled="@busy" />
        <ProductVariantsCard @ref="_variantsCard" ProductSku="@_model.Sku" GalleryImages="@_galleryPreview"
                             AddGalleryFiles="AddGalleryFilesAsync" UploadErrors="@GalleryErrors" InitialOptionTypes="@(InitialData?.OptionTypes ?? [])"
                             InitialVariants="@(InitialData?.Variants ?? [])" StateChanged="OnVariantsStateChanged"
                             RequirePrices="@(_model.IsPublished && HasVariants)" FlaggedVariantIds="@FlaggedVariantIds" Disabled="@busy" />
        <div class="shop-product-form-actions">
            <ShopButton Type="submit" Size="ShopSize.Large" Loading="@busy" EndIcon="@ShopIcons.Outlined.Arrow_Right_MD" data-testid="product-save">@Strings.Save</ShopButton>
            <ShopButton Variant="ShopVariant.Outlined" Size="ShopSize.Large" Disabled="@busy" Href="@Routes.Admin.ManageProducts">@Strings.Cancel</ShopButton>
        </div>
    </BusyFor>
</EditForm>
