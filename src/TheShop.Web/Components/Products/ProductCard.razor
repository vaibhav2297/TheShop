@using TheShop.Web.Common
@using TheShop.Web.Common.UI
@using TheShop.Web.Components.Common
@inherits ShopComponentBase

<article @attributes="AdditionalAttributes" class="@ClassName" style="@Style">
    <div class="shop-product-card-media">
        <ShopImage Src="@Product.ImageUrl"
                   Preset="ShopImagePreset.ProductCard"
                   Alt="@string.Format(Strings.Product_ImageAlt, Product.Name)"
                   PlaceholderLabel="@Product.Name" />

        @if (!Product.IsInStock)
        {
            <span class="shop-product-card-stock">@Strings.OutOfStock</span>
        }

        @if (Product.IsInStock)
        {
            <ShopIconButton Color="ShopColor.Surface" Class="shop-product-card-action shop-product-card-cart"
                            Label="@Strings.AddToCart" Icon="@ShopIcons.Outlined.Shopping_Bag_01"
                            OnClick="OnAddToCartAsync" />
        }

        <ShopIconButton Color="ShopColor.Surface" Class="shop-product-card-action shop-product-card-wishlist"
                        Label="@Strings.Wishlist_Add" Icon="@ShopIcons.Outlined.Heart_01"
                        OnClick="OnToggleWishlistAsync" />
    </div>

    <button type="button" class="shop-product-card-content" @onclick="OnSelectAsync">
        <span class="shop-product-card-brand">@Product.BrandName</span>
        <span class="shop-product-card-title">@Product.Name</span>
        <span class="shop-product-card-pricing">
            @if (Product.IsDiscounted)
            {
                <span class="shop-product-card-price">@CurrencyFormatter.Format(Product.SalePrice!.Value, Product.Currency)</span>
                <s class="shop-product-card-original-price">@CurrencyFormatter.Format(Product.OriginalPrice!.Value, Product.Currency)</s>
            }
            else
            {
                <span class="shop-product-card-price">@PriceLabel</span>
            }
        </span>
    </button>
</article>
