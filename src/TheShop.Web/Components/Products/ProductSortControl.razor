@* Components/Products/ProductSortControl.razor *@
@inherits MudComponentBase

@using TheShop.Web.Resources
@using TheShop.Domain.Enums

<MudStack Class="@Class" Style="@Style" Spacing="2">

    <MudText Typo="Typo.subtitle1"
             Color="Color.Secondary">@Strings.Sort_Label</MudText>

    <MudSelect T="ProductSortOption"
               Value="@Sort"
               ValueChanged="OnValueChangedAsync"
               AdornmentIcon="@ShopIcons.Outlined.Caret_Down_MD"
               AdornmentColor="Color.Primary"
               IconSize="Size.Small"
               Variant="Variant.Outlined"
               Margin="Margin.Dense"
               Dense>

        <MudSelectItem Value="@ProductSortOption.NewestFirst">@Strings.Sort_Newest</MudSelectItem>

        <MudSelectItem Value="@ProductSortOption.PriceLowToHigh">@Strings.Sort_PriceLowHigh</MudSelectItem>

        <MudSelectItem Value="@ProductSortOption.PriceHighToLow">@Strings.Sort_PriceHighLow</MudSelectItem>

        <MudSelectItem Value="@ProductSortOption.NameAToZ">@Strings.Sort_NameAZ</MudSelectItem>

        <MudSelectItem Value="@ProductSortOption.NameZToA">@Strings.Sort_NameZA</MudSelectItem>
    </MudSelect>
</MudStack>
