@using TheShop.Web.Common.UI
@using TheShop.Web.Components.Common

<ShopDialog OnDismiss="CancelAsync"
            MaxWidth="ShopMaxWidth.Small">
    <TitleContent>
        <h2 class="shop-dialog-title">@Strings.VariantImage_Title</h2>
    </TitleContent>
    <DialogContent>
        <div class="shop-variant-image">
            <div class="shop-variant-image-description">
                <p class="shop-variant-image-label">@Strings.VariantImage_VariantFieldLabel</p>
                <p class="shop-variant-image-name">@VariantLabel</p>
            </div>
            @if (GalleryImages.Count == 0)
            {
                <p class="shop-variant-image-empty">@Strings.VariantImage_NoImages</p>
            }
            <div class="shop-variant-image-gallery">
                @for (var index = 0; index < GalleryImages.Count; index++)
                {
                    var image = GalleryImages[index];
                    var selected = _selectedImageId == image.Id;
                    <button @key="image.Id" type="button" class="shop-variant-image-option"
                            aria-label="@string.Format(Strings.VariantImage_ImageLabel, index + 1, VariantLabel)"
                            aria-pressed="@(selected ? "true" : "false")"
                            data-image-id="@image.Id" @onclick="@(() => SelectImage(image.Id))">
                        <ShopImage Src="@image.Url" Preset="ShopImagePreset.Thumbnail"
                                   Alt="@VariantLabel" PlaceholderLabel="@VariantLabel" />
                        @if (selected)
                        {
                            <ShopIcon Icon="@ShopIcons.Outlined.Circle_Check" Class="shop-variant-image-selected-icon" />
                        }
                    </button>
                }
            </div>
            @if (ShowScopeChoice)
            {
                <fieldset class="shop-variant-image-scope">
                    <legend class="shop-variant-image-label">@Strings.VariantImage_ApplyToLabel</legend>
                    <label class="shop-variant-image-choice">
                        <input type="radio" name="@_scopeName" value="all" checked="@_applyToAllSharing"
                               @onchange="@(() => _applyToAllSharing = true)" />
                        <span>@string.Format(Strings.VariantImage_ApplyToAllSharing, SharedScopeCount, SharedScopeLabel)</span>
                    </label>
                    <label class="shop-variant-image-choice">
                        <input type="radio" name="@_scopeName" value="this" checked="@(!_applyToAllSharing)"
                               @onchange="@(() => _applyToAllSharing = false)" />
                        <span>@Strings.VariantImage_ThisVariantOnly</span>
                    </label>
                </fieldset>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <ShopButton OnClick="ConfirmAsync" data-testid="variant-image-save">@Strings.VariantImage_Save</ShopButton>
        <ShopButton Variant="ShopVariant.Outlined" OnClick="CancelAsync"
                    data-dialog-initial-focus data-testid="variant-image-cancel">@Strings.Cancel</ShopButton>
    </DialogActions>
</ShopDialog>
