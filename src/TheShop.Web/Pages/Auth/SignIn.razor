@layout TheShop.Web.Components.Layout.AuthLayout
@attribute [AllowAnonymous]
@using TheShop.Web.Common
@using TheShop.Web.Common.UI
@using TheShop.Web.Components.Common

<PageTitle>@Strings.SignIn_PageTitle</PageTitle>

<div class="shop-native shop-auth">
    <section class="shop-auth-panel" aria-labelledby="signin-title">
        <nav class="shop-auth-navigation">
            <a class="shop-button shop-button-text shop-button-medium" href="@Routes.Auth.SignUp">@Strings.SignUp</a>
        </nav>

        <div class="shop-auth-content">
            <header>
                <h1 id="signin-title" class="shop-auth-title">@Strings.SignIn_Heading</h1>
                <p class="shop-auth-subtitle">@Strings.SignIn_WelcomeBack</p>
            </header>

            <div class="shop-auth-form">
                <p class="shop-auth-instruction" id="signin-instruction">@Strings.Login_Instruction</p>
                <EditForm EditContext="@_editContext" OnSubmit="OnSendCodeAsync" novalidate>
                    <BusyFor Key="@BusyKeys.Auth.SignIn" Context="busy">
                        <div class="shop-field">
                            <label class="shop-field-label" for="signin-email">@Strings.Email_Label</label>
                            <div class="shop-field-control">
                                <ShopIcon Icon="@ShopIcons.Outlined.Mention" Class="shop-field-icon" />
                                <ShopTextInput id="signin-email" type="email" name="email"
                                           @bind-Value="_model.Email"
                                           class="shop-field-input"
                                           placeholder="@Strings.Email_Placeholder"
                                           autocomplete="email" required disabled="@busy"
                                           aria-describedby="signin-instruction signin-error"
                                           data-testid="signin-email" />
                            </div>
                            <div id="signin-error" class="shop-field-error" aria-live="polite">
                                <ValidationMessage For="@(() => _model.Email)" />
                            </div>
                        </div>

                        <div class="shop-auth-actions">
                            <ShopButton Type="submit" Size="ShopSize.Large"
                                        Disabled="@(!CanSubmit)" Loading="@busy" EndIcon="@ShopIcons.Outlined.Arrow_Right_MD"
                                        data-testid="signin-submit">
                                @Strings.Auth_Login_Submit
                            </ShopButton>
                        </div>
                    </BusyFor>
                </EditForm>
            </div>
        </div>
    </section>

    <aside class="shop-auth-brand">
        <ShopImage Src="@ShopIcons.ImageAssets.LogoPrimary"
                   Preset="ShopImagePreset.BrandLogo"
                   Alt="@Strings.AppName"
                   PlaceholderLabel="@Strings.AppName"
                   Class="shop-auth-logo" />
        <p class="shop-auth-tagline">@Strings.App_Tagline</p>
    </aside>
</div>
