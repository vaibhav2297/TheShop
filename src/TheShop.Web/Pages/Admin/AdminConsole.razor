@using TheShop.Web.Common
@using TheShop.Web.Components.Admin
@using TheShop.Web.Components.Common

<PageTitle>@Strings.AdminConsole_PageTitle</PageTitle>

<MudStack Class="pa-8" Spacing="8">

    <MudText Typo="Typo.h3" Class="text-transform-uppercase">@Strings.AdminConsole_Heading</MudText>

    <BusyFor Key="@BusyKeys.AdminDashboard" Context="busy">
        @if (busy)
        {
            <MudGrid>
                @for (var i = 0; i < 5; i++)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="180px" />
                    </MudItem>
                }
            </MudGrid>
        }
        else if (_modules.Count > 0)
        {
            <MudGrid>
                @foreach (var card in _modules)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <AdminModuleCard Module="@card.Module" Count="@card.Count" />
                    </MudItem>
                }
            </MudGrid>
        }
        else
        {
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="4" Class="py-20">
                <MudText Typo="Typo.h4">@Strings.AdminConsole_Welcome</MudText>
                <MudText Typo="Typo.h6"
                         Color="Color.Secondary">@Strings.AdminConsole_NotHaveModulePermission</MudText>
            </MudStack>
        }
    </BusyFor>

</MudStack>
