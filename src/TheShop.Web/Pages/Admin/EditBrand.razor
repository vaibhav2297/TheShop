@using TheShop.Domain.ValueObjects
@using TheShop.Web.Common
@using TheShop.Web.Components.Common

<PageTitle>@Strings.EditBrand_PageTitle</PageTitle>

<AuthorizeView Policy="@PolicyNames.Permission(PermissionCatalogue.Brands.Edit.Code)">
    <Authorized>
        <BusyFor Key="@BusyKeys.Brands.EditBrand" Context="busy">
            @if (busy && string.IsNullOrEmpty(_name) && !_notFound)
            {
                <MudStack Class="pa-8" Spacing="4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="48px" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="240px" />
                </MudStack>
            }
            else if (_notFound)
            {
                <MudStack Class="pa-8" Spacing="4" AlignItems="AlignItems.Start">
                    <MudText Typo="Typo.h4">@Strings.Brand_NotFound</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@Routes.Admin.ManageBrands">
                        @Strings.EditBrand_BackToList
                    </MudButton>
                </MudStack>
            }
            else
            {
                <MudStack Class="pa-8" Spacing="6">
                    <MudText Typo="Typo.h3" Class="text-transform-uppercase">@Strings.EditBrand_Heading</MudText>

                    <MudForm @ref="_form" @bind-IsValid="_isFormValid" SuppressImplicitSubmission="true">
                        <MudGrid Spacing="6">

                            <MudItem xs="12" sm="4" md="3">
                                @if (_hasExistingLogo)
                                {
                                    <MudStack Spacing="2" AlignItems="AlignItems.Start">
                                        <MudImage Src="@_existingLogoUrl"
                                                  Alt="@Strings.AddBrand_LogoLabel"
                                                  Width="120"
                                                  Height="120"
                                                  ObjectFit="ObjectFit.Cover" />
                                        <MudButton Variant="Variant.Text"
                                                   Color="Color.Error"
                                                   Disabled="@busy"
                                                   OnClick="RemoveExistingLogo">
                                            @Strings.AddBrand_LogoRemove
                                        </MudButton>
                                    </MudStack>
                                }
                                else
                                {
                                    <ShopImageUpload Files="_newLogoImages"
                                                     FilesChanged="OnNewLogoImagesChanged"
                                                     UploadText="@Strings.AddBrand_LogoUploadButton"
                                                     RemoveLabel="@Strings.AddBrand_LogoRemove"
                                                     PreviewAlt="@Strings.AddBrand_LogoLabel"
                                                     InvalidTypeError="@Strings.Brand_LogoInvalidType"
                                                     MaxFileSizeError="@Strings.Brand_LogoTooLarge"
                                                     Disabled="@busy" />
                                }
                            </MudItem>

                            <MudItem xs="12" sm="8" md="9">
                                <MudStack Spacing="4">
                                    <MudTextField T="string"
                                                  @bind-Value="_name"
                                                  Placeholder="@Strings.AddBrand_NamePlaceholder"
                                                  Variant="Variant.Filled"
                                                  FullWidth="true"
                                                  Required="true"
                                                  Disabled="@busy"
                                                  OnlyValidateIfDirty
                                                  Validation="@_nameValidation"
                                                  RequiredError="@Strings.Brand_NameRequired"
                                                  Immediate="true" />

                                    <MudTextField T="string"
                                                  @bind-Value="_description"
                                                  Placeholder="@Strings.AddBrand_DescriptionPlaceholder"
                                                  Variant="Variant.Filled"
                                                  FullWidth="true"
                                                  Lines="3"
                                                  Disabled="@busy"
                                                  Validation="@_descriptionValidation"
                                                  Immediate="true" />

                                    <MudDivider />

                                    <MudStack Spacing="2">
                                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@Strings.AddBrand_StatusLabel</MudText>
                                        <MudChipSet T="bool"
                                                    SelectionMode="SelectionMode.SingleSelection"
                                                    @bind-SelectedValue="_isActive"
                                                    CheckMark="false">
                                            <MudChip Value="true"
                                                     Disabled="@busy"
                                                     SelectedColor="Color.Primary"
                                                     Color="Color.Default"
                                                     Variant="Variant.Outlined">@Strings.AddBrand_StatusActive</MudChip>

                                            <MudChip Value="false"
                                                     Disabled="@busy"
                                                     SelectedColor="Color.Primary"
                                                     Color="Color.Default"
                                                     Variant="Variant.Outlined">@Strings.AddBrand_StatusInactive</MudChip>
                                        </MudChipSet>
                                    </MudStack>

                                    <MudDivider />

                                    <MudStack Row="true" Spacing="3">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Disabled="@(!_isFormValid || busy)"
                                                   OnClick="SaveAsync">
                                            @if (busy)
                                            {
                                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                            }
                                            @Strings.Save
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined"
                                                   Disabled="@busy"
                                                   Href="@Routes.Admin.ManageBrands">
                                            @Strings.Cancel
                                        </MudButton>
                                    </MudStack>
                                </MudStack>
                            </MudItem>

                        </MudGrid>
                    </MudForm>
                </MudStack>
            }
        </BusyFor>
    </Authorized>
    <NotAuthorized>
        <AccessDeniedView />
    </NotAuthorized>
</AuthorizeView>
