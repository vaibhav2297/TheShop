@inherits QueryStatePageBase<CategoryQueryState>

@using TheShop.Application.Features.Categories.DTOs
@using TheShop.Domain.Enums
@using TheShop.Domain.ValueObjects
@using TheShop.Web.Common
@using TheShop.Web.Common.UI
@using TheShop.Web.Components.Common

<PageTitle>@Strings.ManageCategories_PageTitle</PageTitle>

<section class="shop-native shop-categories-page">
    <header class="shop-categories-heading">
        <h1>@Strings.ManageCategories_Heading</h1>
        <AuthorizeView Policy="@PolicyNames.Permission(PermissionCatalogue.Categories.Create.Code)" Context="createAuth">
            <Authorized>
                <ShopButton Href="@Routes.Admin.AddCategory" Size="ShopSize.Large" EndIcon="@ShopIcons.Outlined.Add_Plus">
                    @Strings.AddCategory_Heading
                </ShopButton>
            </Authorized>
        </AuthorizeView>
    </header>

    <div class="@ListClass">

        <aside class="shop-categories-sidebar">
            <BusyFor Key="@BusyKeys.Categories.ManageList" Context="loadingFilters">
                @if (loadingFilters && !_categories.HasLoaded)
                {
                    <div class="shop-categories-filter-skeleton" aria-hidden="true">
                        @for (var i = 0; i < 5; i++)
                        {
                            <div class="shop-categories-filter-placeholder">
                                <ShopSkeleton Class="shop-categories-filter-placeholder-title" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <ShopFilterPanel Class="shop-categories-filter-panel shop-categories-sidebar-filter"
                             InitiallyExpanded="true" ClearLabel="@Strings.Filter_ClearAll" Groups="@FilterGroups"
                             SelectedFilters="@SelectedFilters"
                             SingleSelectChanged="OnSingleSelectChangedAsync"
                             OnClearFilters="OnClearFiltersAsync" />
                }
            </BusyFor>
        </aside>

        <div class="shop-categories-results">


                <div class="shop-categories-tools">
                    <div class="shop-categories-search">
                        <ShopTextField type="search" Value="@_search" ValueChanged="OnSearchInputAsync"
                                       ValueExpression="@(() => _search)"
                                       StartIcon="@ShopIcons.Outlined.Search_Magnifying_Glass"
                                       Label="@Strings.ManageCategories_SearchPlaceholder" />
                    </div>
                    <ShopButton Class="shop-categories-filter-button" Variant="ShopVariant.Outlined" Size="ShopSize.Large"
                                StartIcon="@ShopIcons.Outlined.Filter" OnClick="@(() => _filtersOpen = true)">
                        @Strings.Categories_Filters
                    </ShopButton>
                    <ShopSortSelect TSort="CategorySortOption" Class="shop-categories-sort" Sort="@_sort" Options="@SortOptions" SortChanged="OnSortChangedAsync" />
                </div>

                <ShopBulkActionBar Visible="@HasSelection"
                                   SelectedCount="@_selectedItems.Count"
                                   OnClose="OnCloseBulkActions">
                    <Actions>
                        <BusyFor Keys="@MutationBusyKeys" Context="mutating">
                            <AuthorizeView Policy="@PolicyNames.Permission(PermissionCatalogue.Categories.Edit.Code)"
                                           Context="bulkEditAuth">

                                <Authorized>

                                    <ShopButton Variant="ShopVariant.Outlined"
                                               Color="ShopColor.Primary"
                                               StartIcon="@ShopIcons.Outlined.Show"
                                               Disabled="@mutating"
                                               OnClick="BulkActivateAsync">
                                        <span class="shop-bulk-action-text">@Strings.ManageCategories_BulkSetActive</span>
                                    </ShopButton>

                                    <ShopButton Variant="ShopVariant.Outlined"
                                               Color="ShopColor.Primary"
                                               StartIcon="@ShopIcons.Outlined.Hide"
                                               Disabled="@mutating"
                                               OnClick="BulkDeactivateAsync">
                                        <span class="shop-bulk-action-text">@Strings.ManageCategories_BulkSetInactive</span>
                                    </ShopButton>
                                </Authorized>

                            </AuthorizeView>

                            <AuthorizeView Policy="@PolicyNames.Permission(PermissionCatalogue.Categories.Delete.Code)" Context="bulkDeleteAuth">

                                <Authorized>

                                    <ShopButton Variant="ShopVariant.Outlined"
                                               Color="ShopColor.Error"
                                               StartIcon="@ShopIcons.Outlined.Trash_Empty"
                                               Disabled="@mutating"
                                               OnClick="BulkDeleteAsync">
                                        <span class="shop-bulk-action-text">@Strings.ManageCategories_BulkDelete</span>
                                    </ShopButton>

                                </Authorized>

                            </AuthorizeView>
                        </BusyFor>
                    </Actions>
                </ShopBulkActionBar>

                <BusyFor Key="@BusyKeys.Categories.ManageList" Context="busy">
                    @if (busy || _categories.Items.Count > 0)
                    {
                        <BusyFor Keys="@MutationBusyKeys" Context="mutating">
                            <ShopTable TItem="CategoryListItemDto"
                                      Loading="@busy" Class="shop-categories-table"
                                      Items="@_categories.Items"
                                      ItemKey="@(item => item.Id)"
                                      Caption="@Strings.ManageCategories_Heading"
                                      ColumnCount="4"
                                      Selectable="true"
                                      SelectedKeys="@SelectedKeys"
                                      SelectedKeysChanged="OnSelectedKeysChanged"
                                      RowSelectionLabel="@(item => string.Format(Strings.Table_SelectRow, item.Name))"
                                      SelectionDisabled="@mutating">

                                <HeaderContent>
                                    <th scope="col">@Strings.ManageCategories_ColumnName</th>
                                    <th scope="col">@Strings.ManageCategories_ColumnDescription</th>
                                    <th scope="col" class="shop-table-column-compact">@Strings.ManageCategories_ColumnStatus</th>
                                    <th scope="col" class="shop-table-column-compact">@Strings.ManageCategories_ColumnActions</th>
                                </HeaderContent>

                                <RowTemplate Context="category">
                                    <td>
                                        <div class="shop-categories-name">
                                            <div class="shop-categories-image">
                                                <ShopImage Src="@category.ImageUrl" Preset="ShopImagePreset.SquareContain" Alt="@category.Name" PlaceholderLabel="@category.Name" />
                                            </div>
                                            <div>
                                                <span>@category.Name</span>

                                                @if (_blockedIds.Contains(category.Id))
                                                {
                                                    <span class="shop-categories-in-use">
                                                        @string.Format(Strings.ManageCategories_InUseIndicator, category.ProductCount)
                                                    </span>
                                                }

                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span>@category.Description</span>
                                    </td>
                                    <td class="shop-table-column-compact">
                                        <AuthorizeView Policy="@PolicyNames.Permission(PermissionCatalogue.Categories.Edit.Code)" Context="statusAuth">
                                            <Authorized>

                                                @* The spinner takes the chip's place rather than sitting beside it: the
                                                   user just clicked here, so this is the one spot guaranteed to be in
                                                   view — unlike the table's progress bar up under the header. *@
                                                @if (IsRowPending(category.Id, RowMutation.Status))
                                                {
                                                    <span role="status" aria-label="@Strings.Loading"><ShopLoader Class="shop-loader-inline" /></span>
                                                }
                                                else
                                                {
                                                    <ShopChip Size="ShopSize.Small" Selected="@category.IsActive" Disabled="@mutating"
                                                              SelectedChanged="@((bool active) => OnStatusToggledAsync(category, active))">
                                                        @(category.IsActive ? Strings.AddCategory_StatusActive : Strings.AddCategory_StatusInactive)
                                                    </ShopChip>
                                                }

                                            </Authorized>
                                            <NotAuthorized>
                                                <span>
                                                    @(category.IsActive ? Strings.AddCategory_StatusActive : Strings.AddCategory_StatusInactive)
                                                </span>
                                            </NotAuthorized>
                                        </AuthorizeView>
                                    </td>
                                    <td class="shop-table-column-compact">
                                        @* A deletion replaces the whole action group, not just the trash button:
                                           leaving Edit live next to a spinner would invite a navigation away from
                                           the row mid-delete. *@
                                        @if (IsRowPending(category.Id, RowMutation.Delete))
                                        {
                                            <span role="status" aria-label="@Strings.Loading"><ShopLoader Class="shop-loader-inline shop-loader-error" /></span>
                                        }
                                        else
                                        {
                                            <div class="shop-categories-row-actions">
                                                <AuthorizeView Policy="@PolicyNames.Permission(PermissionCatalogue.Categories.Edit.Code)" Context="editRowAuth">
                                                    <Authorized>

                                                        <ShopIconButton Href="@Routes.Admin.EditCategory(category.Id)"
                                                                        Disabled="@mutating" Variant="ShopVariant.Text"
                                                                        Icon="@ShopIcons.Outlined.Edit_Pencil_02"
                                                                        Label="@string.Format(Strings.ManageCategories_EditAria, category.Name)" />


                                                    </Authorized>
                                                </AuthorizeView>
                                                <AuthorizeView Policy="@PolicyNames.Permission(PermissionCatalogue.Categories.Delete.Code)" Context="deleteRowAuth">
                                                    <Authorized>

                                                        <ShopIconButton Icon="@ShopIcons.Outlined.Trash_Empty"
                                                                       Color="ShopColor.Error"
                                                                       Disabled="@mutating"
                                                                       OnClick="@(() => DeleteSingleAsync(category))"
                                                                       Variant="ShopVariant.Text" Label="@string.Format(Strings.ManageCategories_DeleteAria, category.Name)" />

                                                    </Authorized>
                                                </AuthorizeView>
                                            </div>
                                        }
                                    </td>
                                </RowTemplate>
                            </ShopTable>
                        </BusyFor>

                        if (!busy)
                        {
                            <ShopPagination Page="@_categories.Page"
                                            TotalPages="@_categories.TotalPages"
                                            PageChanged="OnPageChangedAsync"
                                            Class="shop-categories-pagination" />
                        }
                    }
                    else if (_search is not null || _status is not null)
                    {
                        <div class="shop-categories-empty">
                            <h2>@Strings.ManageCategories_NoMatchTitle</h2>
                            <p>@Strings.ManageCategories_NoMatchDescription</p>
                        </div>
                    }
                    else
                    {
                        <div class="shop-categories-empty">
                            <h2>@Strings.ManageCategories_EmptyTitle</h2>
                            <p>@Strings.ManageCategories_EmptyDescription</p>
                        </div>
                    }
                </BusyFor>
        </div>
    </div>
</section>

<ShopDrawer @bind-Open="_filtersOpen" Side="ShopDrawerSide.Left">
    <HeaderContent><h2 class="shop-drawer-title">@Strings.Categories_Filters</h2></HeaderContent>
    <DrawerContent>
        <ShopFilterPanel Class="shop-categories-filter-panel" InitiallyExpanded="true"
                         ClearLabel="@Strings.Filter_ClearAll"
                         Groups="@FilterGroups" SelectedFilters="@SelectedFilters"
                         SingleSelectChanged="OnSingleSelectChangedAsync" OnClearFilters="OnClearFiltersAsync" />
    </DrawerContent>
</ShopDrawer>
